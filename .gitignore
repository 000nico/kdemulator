# --- Rust / Cargo ---
/target/
**/target/
Cargo.lock
# If any crate ends up being a library consumed by others and you want
# reproducible builds for it specifically, remove the line above and
# .gitignore the lock file per-crate instead.

# Backup files generated by rustfmt
**/*.rs.bk

# --- Build artifacts (native libs from PyO3 embedding, if any get produced) ---
*.dll
*.so
*.dylib
*.pdb
*.exp
*.lib

# --- Python (interpreter embedded at runtime, stub files are user content) ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/

# --- Driver samples / test binaries ---
# Real .sys files used for local testing are usually not meant for the repo
# (size, licensing, or provenance reasons). Whitelist specific known-safe
# samples explicitly if needed with '!path/to/file.sys'.
*.sys
*.dmp
/tests/samples/
/tests/fixtures/*.sys

# --- Fuzzing output ---
/corpus/
/crashes/
/hangs/
*.fuzzcase

# --- Logs ---
*.log
/logs/
.cache/
build/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Environment / local config ---
.env
.env.local
*.local.toml

# --- OS junk ---
desktop.ini
